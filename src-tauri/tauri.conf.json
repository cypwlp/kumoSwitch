{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kumoSwitch",
  "version": "0.16.0",
  "identifier": "io.github.cypwlp.kumoswitch",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "kumoSwitch — AI CLI 供應商切換器",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "cypwlp",
    "homepage": "https://cypwlp.github.io/kumoSwitch/",
    "copyright": "Copyright © 2026 kumoSwitch contributors",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser",
        "compression": "lzma",
        "startMenuFolder": "kumoSwitch",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "uninstallerHeaderImage": "nsis/header-uninstall.bmp",
        "languages": ["English", "TradChinese"],
        "customLanguageFiles": {
          "English": "nsis/languages/English.nsh",
          "TradChinese": "nsis/languages/TradChinese.nsh"
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cypwlp/kumoSwitch/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMTFCODJCNDNEOURBMkMKUldRczJ0bERLN2dSdjRnQ2NTVm5BMnpyVXFyMkVwK0xNQ0dEREFQbTA2OUh0dENuY3pXVW5QUCsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
