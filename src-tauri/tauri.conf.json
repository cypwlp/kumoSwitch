{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwitchYard",
  "version": "0.2.1",
  "identifier": "io.github.switchyard",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SwitchYard — AI CLI 供應商切換器",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cypwlp/SwitchYard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMTFCODJCNDNEOURBMkMKUldRczJ0bERLN2dSdjRnQ2NTVm5BMnpyVXFyMkVwK0xNQ0dEREFQbTA2OUh0dENuY3pXVW5QUCsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
